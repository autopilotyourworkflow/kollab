# Kollab backend configuration — every value is OPTIONAL.
# With none set, the API runs in credential-free fixtures mode (the deployed demo).
#
# Honesty note: the keys below are read and surfaced in /health, but the live
# paths they belong to are ROADMAP in this build (see README "What's built vs.
# roadmap"). Selecting the apify source makes /api/shortlist answer an honest
# 503 — never a fabricated result.

KOLLAB_SOURCE=seed          # seed | apify   (apify = public-data sampling, prototyping only;
                            #                 actor-run loop lands with the recorded live run)
APIFY_TOKEN=                # for the ApifyAdapter's recorded live run (roadmap)
ANTHROPIC_API_KEY=          # reserved for live Brand DNA extraction + LLM rerank (roadmap)
GEMINI_API_KEY=             # reserved: degradation fallback (Claude -> Gemini -> rules) (roadmap)
KOLLAB_MIN_COHORT_N=15      # outlier signals withhold below this cohort size (live today)
