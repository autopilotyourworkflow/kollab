# Kollab backend configuration — every value is OPTIONAL.
# With none set, the API runs in credential-free fixtures mode (the deployed demo).

KOLLAB_SOURCE=seed          # seed | apify   (apify = public-data sampling, prototyping only)
APIFY_TOKEN=                # enables ApifyAdapter for the recorded live run
ANTHROPIC_API_KEY=          # enables live Brand DNA extraction + citation-grounded rerank
GEMINI_API_KEY=             # degradation fallback for Brand DNA (Claude -> Gemini -> rules)
KOLLAB_MIN_COHORT_N=15      # outlier signals withhold below this cohort size
