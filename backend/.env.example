# Kollab backend configuration — every value is OPTIONAL.
# With none set, the API runs in credential-free fixtures mode (the deployed demo).
#
# The live paths (Apify sourcing loop, Claude/Gemini Brand DNA + citation-validated
# rerank) are implemented and tested against fakes; supplying a key switches them
# on. They need the live extras: `pip install -e .[live]`. First run against the
# real actors is a calibration run. Anything a key can't cover fails as an honest
# 4xx/503 with the reason — never a fabricated result.

KOLLAB_SOURCE=seed          # seed | apify  (apify = live public-data sampling, prototyping
                            #  only; needs APIFY_TOKEN + apify-client; POST a brief to run)
APIFY_TOKEN=                # enables the ApifyAdapter's budget-capped sourcing loop
KOLLAB_RUN_BUDGET_USD=5     # hard USD cap per live sourcing run (stops BEFORE crossing)
KOLLAB_REGION=TH            # ISO country: routes the scraper's proxy so search returns
                            #  local creators (TH = Thailand, the target market; None = global)

ANTHROPIC_API_KEY=          # enables Brand DNA extraction (POST /api/brand-dna) and the
                            #  citation-validated LLM rerank of the top of the shortlist
GEMINI_API_KEY=             # degradation fallback (Claude -> Gemini -> rules skeleton)
KOLLAB_CLAUDE_MODEL=claude-sonnet-5
KOLLAB_GEMINI_MODEL=gemini-2.5-flash
KOLLAB_LLM_RERANK=1         # set 0 to keep deterministic why-copy even with a key

KOLLAB_MIN_COHORT_N=15      # outlier signals withhold below this cohort size
